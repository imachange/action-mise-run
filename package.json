{
  "name": "action-mise-run",
  "version": "0.1.0",
  "description": "Hybrid mise task runner across base and target repositories for GitHub Actions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && esbuild src/cleanup.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/cleanup.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@actions/cache": "^4.0.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "eslint-plugin-tsdoc": "^0.3.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  }
}
